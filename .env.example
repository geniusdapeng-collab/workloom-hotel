# ============ 数据库（docker-compose 默认口径） ============
DATABASE_URL=postgres://postgres:workloom@localhost:5432/workloom
# 应用双角色（A3：旁路直写防控——只有 gateway 角色可 INSERT biz_events）
APP_DB_PASSWORD=workloom_dev_app
GATEWAY_DB_PASSWORD=workloom_dev_gateway
DATABASE_APP_URL=postgres://workloom_app:workloom_dev_app@localhost:5432/workloom
DATABASE_GATEWAY_URL=postgres://workloom_gateway:workloom_dev_gateway@localhost:5432/workloom

# ============ LLM（可选；默认 mock，离线可跑通全流程） ============
# mock | deepseek | moonshot | zhipu | openai
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
# 非 mock 时，非空 LLM_MODEL + LLM_BASE_URL 显式启用单模型部署，覆盖目录中的全部路由槽位。
# 此时 L1/L2/L3 仅为策略与积分档位，升档不代表换了更强模型；model_trace 记录实际模型 ID。
# 单模型模式不会读取其他 vendor 的 BASE_URL；LLM_MODEL 留空则沿用原有多提供方目录池。
# 密钥通过服务端进程环境注入，禁止使用 VITE_* 或写入前端构建产物。
LLM_MODEL=

# 酒店内部分析/草稿可显式开启 DeepSeek 官方公开检索；来源以独立 Search API 回执为准。
# 使用 deepseek-flash 时，不把模型自身文本当成已联网搜索。
# 未配置 DEEPSEEK_API_KEY 时复用服务端 LLM_API_KEY；真实密钥仍仅在运行时注入。
DEEPSEEK_SEARCH_ENABLED=0
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
# 每次推进最多完成的内部岗位数（1–5，默认5）；暂停后续跑复用原计划与已交付回执。
HOTEL_DELIVERY_MAX_WORKERS_PER_RUN=5

# ============ IM 通道（B11/D14；默认 mock，无凭据全流程可跑——与 LLM 同纪律） ============
# mock | dsh-im（真实通道凭据在 dsh 设置页配置：bash scripts/install-im-channels.sh 后 dsh web → IM机器人）
IM_DRIVER=mock

# ============ 演示身份 JWT（B5） ============
# 生产（NODE_ENV=production）必配：缺失直接拒启；<32 字符启动告警（熵不足）
# 生成建议：openssl rand -hex 32
JWT_SECRET=workloom-dev-secret-change-me

# ============ PII 脱敏盐（M2-PII；生产必配） ============
# 占位符 HMAC-SHA256 盐（workdata/pii.ts，防彩虹表反推明文）；生产必须注入，变更后新旧占位符不可关联
PII_SALT=workloom-dev-pii-salt

# ============ 服务端口 ============
SERVER_PORT=8787
WEB_PORT=5173

# ============ 桌面端首启种子脚本（按仓配置；不在 base-sync 同步范围，各仓自定） ============
DESKTOP_SEED_SCRIPT=scripts/seed.ts
