      "welcome": {
        "system": [
          "这是一套面向住宿经营的智能经营系统。数字员工持续关注房价、评价、订单、客房与住客服务，高风险动作始终由您裁决。"
        ],
        "keywords": [
          "房态异常",
          "差评处置",
          "订单对账",
          "夜班交接"
        ],
        "cards": [
          {
            "t": "昨夜它做了什么",
            "d": "凌晨 2 点住客来电要求延迟退房，语音前台 47 秒接听并办结；差评 2 小时内处置完毕，对账连续 30 天零差错。"
          },
          {
            "t": "今天它在盯什么",
            "d": "房态异常、渠道价格倒挂、入退高峰排队都在实时巡检；周末提价建议已按预测入住率算好，等您拍板。"
          },
          {
            "t": "您只要做两件事",
            "d": "听晨报、批关键决策。送物、报修、排房、回评价这些琐事，数字员工在围栏内自动办结，全程留痕可回放。"
          }
        ]
      },
